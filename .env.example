# Which AI provider to use: "anthropic" or "gemini". Only the matching
# key/model pair below needs to be filled in - switching providers later is
# just changing this one line, no code changes needed.
AI_PROVIDER=anthropic

AI_API_KEY_ANTHROPIC=your-anthropic-key-here
AI_MODEL_ANTHROPIC=claude-opus-5

AI_API_KEY_GROQ=your-groq-key-here
AI_MODEL_GROQ=llama-3.3-70b-versatile

AI_API_KEY_GEMINI=your-gemini-key-here
AI_MODEL_GEMINI=gemini-3.6-flash

PORT=3000
